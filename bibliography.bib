	keywords = {Maintenance engineering, Cyber-physical systems, Artificial intelligence, Biological system modeling, Life cycle assessment, fault diagnosis, Fault diagnosis, Industrial cyber-physical systems, Industrial engineering, industrial process knowledge, large-scale foundation models, prognostics and health management, Prognostics and health management, remaining useful life, Sensors},
	pages = {264--280},
	file = {Full Text PDF:source-pdfs/files/1284/Liu et al. - 2024 - Survey on Foundation Models for Prognostics and He.pdf:application/pdf;IEEE Xplore Abstract Record:files/1283/10592003.html:text/html},
