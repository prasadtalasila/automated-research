	title = {Modelling for {Digital} {Twins}},
	isbn = {978-3-031-66719-0},
	url = {https://doi.org/10.1007/978-3-031-66719-0_5},
	doi = {10.1007/978-3-031-66719-0_5},
	abstract = {At the heart of a digital twin is one or more models of the real-world system that it aims to describe. There are many facets to real-world systems, and many types of model available to describe them, each with different strengths. We provide an introduction to a range of model types. These include physics-based models founded on first principles laws, data-driven models derived by machine learning from experimental data, and formalisms rooted in discrete mathematics and logic to describe computational processes. We describe approaches to harnessing these diverse types of model together, in particular co-simulation in which models are integrated in a principled and coordinated execution, and the formal integration of discrete and continuous behaviours in hybrid automata. The practical use of some of the most common formalisms has been showcased using an incubator example.},
	language = {en},
	urldate = {2024-12-18},
	booktitle = {The {Engineering} of {Digital} {Twins}},
	publisher = {Springer International Publishing},
	author = {Abbiati, Giuseppe and Gomes, Cláudio and Sandberg, Michael and Kazemi, Zahra and Hansen, Simon Thrane and Larsen, Peter Gorm},
