}

@article{viceconti_position_2024,
	title = {Position {Paper} {From} the {Digital} {Twins} in {Healthcare} to the {Virtual} {Human} {Twin}: {A} {Moon}-{Shot} {Project} for {Digital} {Health} {Research}},
	volume = {28},
	issn = {2168-2208},
	shorttitle = {Position {Paper} {From} the {Digital} {Twins} in {Healthcare} to the {Virtual} {Human} {Twin}},
	url = {https://ieeexplore.ieee.org/document/10278402},
	doi = {10.1109/JBHI.2023.3323688},
	abstract = {The idea of a systematic digital representation of the entire known human pathophysiology, which we could call the Virtual Human Twin, has been around for decades. To date, most research groups focused instead on developing highly specialised, highly focused patient-specific models able to predict specific quantities of clinical relevance. While it has facilitated harvesting the low-hanging fruits, this narrow focus is, in the long run, leaving some significant challenges that slow the adoption of digital twins in healthcare. This position paper lays the conceptual foundations for developing the Virtual Human Twin (VHT). The VHT is intended as a distributed and collaborative infrastructure, a collection of technologies and resources (data, models) that enable it, and a collection of Standard Operating Procedures (SOP) that regulate its use. The VHT infrastructure aims to facilitate academic researchers, public organisations, and the biomedical industry in developing and validating new digital twins in healthcare solutions with the possibility of integrating multiple resources if required by the specific context of use. Healthcare professionals and patients can also use the VHT infrastructure for clinical decision support or personalised health forecasting. As the European Commission launched the EDITH coordination and support action to develop a roadmap for the development of the Virtual Human Twin, this position paper is intended as a starting point for the consensus process and a call to arms for all stakeholders.},
	number = {1},
	urldate = {2024-11-28},
	journal = {IEEE Journal of Biomedical and Health Informatics},
	author = {Viceconti, Marco and De Vos, Maarten and Mellone, Sabato and Geris, Liesbet},
	month = jan,
	year = {2024},
	note = {Conference Name: IEEE Journal of Biomedical and Health Informatics},
	keywords = {Computational modeling, Digital twins, Data models, Medical services, Ecosystems, Predictive models, Biological system modeling, Digital human twin, digital twins in healthcare, in silico medicine, in silico trials, personal health forecasting},
	pages = {491--501},
	file = {Full Text PDF:source-pdfs/files/985/Viceconti et al. - 2024 - Position Paper From the Digital Twins in Healthcar.pdf:application/pdf;IEEE Xplore Abstract Record:files/984/10278402.html:text/html},
}

