	abstract = {The Mass Customization Network (MCN), a central component of the Digital Twin Consortium’s “Buildings as Batteries” Technology Showcase, holds substantial promise for numerous stakeholders seeking to integrate their capabilities into real-world production environments, thereby advancing global infrastructure. Rooted in the principles of biomimicry, akin to the approach that underpinned the development of the global Internet, MCN was initially conceived during research conducted within the United States Department of Defense, with a primary focus on bolstering the resilience of military base infrastructure worldwide. Intriguingly, this concept is remarkably applicable to decentralized global infrastructure within urban settings, campuses, buildings, and transportation systems and extends its relevance to encompass energy and telecommunications systems. This chapter endeavors to construct a conceptual framework facilitating the synergistic alignment of Digital Twin and MCN, identifying critical knowledge gaps in domains related to Smart Grids, Buildings as Batteries, and Peer-to-Peer Energy Transfer. Additionally, the chapter offers an architectural overview of the framework designed to implement a pivotal phase in decentralizing the electric grid, specifically targeting the realization of Grid-Enabled Buildings, or “Buildings as Batteries.” To exemplify the value proposition of the Mass Customization Network, the conceptual framework is subjected to scrutiny through a use case analysis, concluding with a forward-looking agenda for future research and development in this domain.},
	language = {en},
	urldate = {2024-12-18},
	booktitle = {Digital {Twin}: {Fundamentals} and {Applications}},
	publisher = {Springer Nature Switzerland},
	author = {Reynolds, John and Sabri, Soheil and Lee, Benjamin},
	editor = {Sabri, Soheil and Alexandridis, Kostas and Lee, Newton},
	year = {2024},
	keywords = {Digital twin, Building as batteries, Grid-enabled buildings, Mass customization network, P2P energy transfer, Smart grid},
	pages = {191--209},
	file = {Full Text PDF:source-pdfs/files/1141/Reynolds et al. - 2024 - Digital Twins for Creating Value Through “Building.pdf:application/pdf},
}

@incollection{azevedo_human_2024,
	address = {Cham},
	title = {Human {Digital} {Twins} to {Support} {Nurse} {Practitioners}’ {Clinical} {Decision}-{Making} {Using} {Multimodal} {Data}: {A} {Theoretical}, {Methodological}, and {Analytical} {Framework}},
	isbn = {978-3-031-67778-6},
	shorttitle = {Human {Digital} {Twins} to {Support} {Nurse} {Practitioners}’ {Clinical} {Decision}-{Making} {Using} {Multimodal} {Data}},
	url = {https://doi.org/10.1007/978-3-031-67778-6_7},
	doi = {10.1007/978-3-031-67778-6_7},
	abstract = {This chapter proposes a theoretical, methodological, and analytical approach to supporting nurse practitioners’ clinical decision-making using human digital twins (HDTs). HDTs are symbolic digital replicas of (real) humans that can serve as a novel research platform to represent, model, and simulate how healthcare professionals with varying levels of expertise, knowledge, and skills behave, operate, and reason across various contexts including blended learning immersive environments while caring for patients. We argue that clinicians can augment or accelerate their clinical decision-making (CDM) skills and knowledge development by designing, modeling, and testing HDT supports for use while caring for actual or simulated patients. We adopt the exemplar of preceptors as CDM supports in immersive virtual environments, which can be used in conjunction with traditional methods (e.g., through explicit verbal instruction of the CDM process) and novel uses of displaying, duplicating, merging, and exchanging their multimodal multichannel data (e.g., eye movements, concurrent verbalizations, facial expressions of emotions, physiology, affective states). An exemplar scenario is outlined.},
	language = {en},
	urldate = {2024-12-18},
	booktitle = {Digital {Twin}: {Fundamentals} and {Applications}},
	publisher = {Springer Nature Switzerland},
	author = {Azevedo, Roger and Amon, Mary Jean and Anderson, Mindi and Mondesire, Sean and Guido-Sanz, Francisco and Sottilare, Robert and Wiedbusch, Megan},
	editor = {Sabri, Soheil and Alexandridis, Kostas and Lee, Newton},
	year = {2024},
	keywords = {Training, Healthcare, Clinical decision-making, Human digital twin, Multimodal data, Nurse practitioner, Preceptorship},
	pages = {149--172},
	file = {Full Text PDF:source-pdfs/files/1142/Azevedo et al. - 2024 - Human Digital Twins to Support Nurse Practitioners.pdf:application/pdf},
}

@incollection{heithoff_model-based_2024,
	address = {Cham},
	title = {Model-{Based} {Engineering} of {Multi}-{Purpose} {Digital} {Twins} in {Manufacturing}},
	isbn = {978-3-031-67778-6},
	url = {https://doi.org/10.1007/978-3-031-67778-6_5},
	doi = {10.1007/978-3-031-67778-6_5},
	abstract = {The engineering of digital twins for manufacturing can benefit greatly from automated or semi-automated methods, as opposed to the current manual software development methods limited to specific use cases. The manufacturing domain already holds a large amount of data and models that can be used in these engineering processes and during runtime of digital twins. Within this chapter, we show how to apply model-driven engineering methods to the development of digital twins. Specifically, we present the necessary architectural components required for the development of reusable digital twins supporting multiple purposes, as well as the data-to-model and model-to-model transformation methods that can be applied for digital twin engineering. In addition, we discuss the architecture and the runtime use of models in the digital twin, using relevant use cases from the manufacturing domain to illustrate our approach. Overall, we show that model-driven engineering approaches are transferable to engineering digital twins for manufacturing with all its advantages, such as mastering complexity and properly involving domain experts.},
	language = {en},
	urldate = {2024-12-18},
	booktitle = {Digital {Twin}: {Fundamentals} and {Applications}},
	publisher = {Springer Nature Switzerland},
	author = {Heithoff, Malte and Jansen, Nico and Michael, Judith and Rademacher, Florian and Rumpe, Bernhard},
	editor = {Sabri, Soheil and Alexandridis, Kostas and Lee, Newton},
	year = {2024},
	keywords = {Digital Twin, Model-Driven Engineering, Model-Based Systems Engineering, Domain-Specific Languages, Injection Molding, Manufacturing},
	pages = {89--126},
	file = {Full Text PDF:source-pdfs/files/1143/Heithoff et al. - 2024 - Model-Based Engineering of Multi-Purpose Digital T.pdf:application/pdf},
}

@incollection{alexandridis_social_2024,
	address = {Cham},
	title = {Social and {Human} {Dimensions} of {Digital} {Twin} {Technologies} in {Formal} and {Informal} {Institutional} {Settings}},
	isbn = {978-3-031-67778-6},
	url = {https://doi.org/10.1007/978-3-031-67778-6_10},
	doi = {10.1007/978-3-031-67778-6_10},
	abstract = {The proliferation of digital technologies with visualization-rich capabilities has been in the forefront of innovation for the past few years. Bridging the digital gap both across global, regional, and local communities, as well as within societal groups is an issue requiring consideration and attention when considering the impact of these digital technologies in our communities at large. The chapter examines the role of digital twin technologies in addressing capacities and capabilities with respect to the digital divide. It addresses the role of advanced and complex visualization technologies and big data to empower citizens in vulnerable and disadvantaged communities in increasing participation in policy and governance in public institutional settings. The study offers a set of guiding principles and goals in positively and constructively addressing inclusiveness, representativeness, equality and empowerment in collaborative public digital institutions and the management of the commons. More specifically: the need for broad consensus and scope; properly framing opportunities and challenges within an institutional framework; addressing normative, implementational and strategic dimensions for institutional digital twins; encapsulating digital divide, digital inequalities and socio-technical aspects of institutional change; adopting a coupled cognitive and institutional approach to capacity and capability development; incorporating genuine intelligent data and decision-centric aspects of technology; develop co-management and bottom-up participatory structures, and; balance proactive with reactive development and feedback mechanisms for digital twin development.},
	language = {en},
	urldate = {2024-12-18},
	booktitle = {Digital {Twin}: {Fundamentals} and {Applications}},
	publisher = {Springer Nature Switzerland},
	author = {Alexandridis, Kostas and LaFontaine, Michael},
	editor = {Sabri, Soheil and Alexandridis, Kostas and Lee, Newton},
	year = {2024},
	keywords = {Digital twin, Critical infrastructure, Digital transformation, Human dimensions, Institutional arrangements, OCDT, Public institutions},
	pages = {211--236},
	file = {Full Text PDF:source-pdfs/files/1144/Alexandridis and LaFontaine - 2024 - Social and Human Dimensions of Digital Twin Techno.pdf:application/pdf},
}

