	month = mar,
	year = {2024},
	keywords = {Clinical trial design, Drug development},
	pages = {77},
	file = {Full Text PDF:source-pdfs/files/1737/Katsoulakis et al. - 2024 - Digital twins for health a scoping review.pdf:application/pdf},
}

