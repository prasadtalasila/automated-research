@book{wagner_data-driven_2025,
	title = {Data-{Driven} {Updating} of {Digital} {Twins} through {Experimental} {Measurements} and {Parametric} {Finite} {Element} {Model} {Optimization}},
	abstract = {This work focuses on the development and continuous updating of a Digital Twin. It is built upon an intelligent combination of experimental measurement data and numerical models. Methodology: Data Acquisition and Modelling For data acquisition, vibration measurements are conducted on a physical system, utilizing three different data acquisition systems. The collected measurement data are subsequently processed using Operational Modal Analysis (OMA). The open-source library pyOMA2 is employed for OMA to extract the system's characteristic natural frequencies. In parallel, a detailed Finite Element Model (FEM) of the physical system is constructed using the PERMAS software. The natural frequencies obtained from OMA serve as target values for a parameter optimization within the FE model. This process, known as Finite Element Model Updating (FEMU), enables the iterative adjustment of design variables (e.g., material parameters, geometry) in the FE model to match the real structural behavior. Continuous Updating and Prognostic Capability A key feature of this Digital Twin is the continuous recording of measurement data. This allows for the periodic updating of the FE model at specific time points. Through this continuous reconciliation between the real system and its digital counterpart, the accuracy and prognostic capability of the Digital Twin are significantly improved and ensured over time. Industrial Applications The described methodology for a Digital Twin, which combines experimental vibration data, FEMU, and continuous data recording, is ideal for a wide range of industrial applications, particularly where the structural integrity, dynamic behavior, and lifespan of assets are critical. Key applications include:-Remaining Useful Life (RUL) Prediction: Through the continuous calibration of the FE model with real data, fatigue and damage models can be trained and utilized more accurately to predict the remaining useful life of a component or structure.-"What-if" simulations: Having the updated FEM, an engineer can run several hundreds of "standard" simulation scenarios to check how the structure in the current state will react to different excitation. Normally, engineers do this for "as-designed" FEM, but now they can do this for "as-is" model as well.-Design Validation and Product Development: Iterative adjustments in the FE model, based on experimental data, accelerate the development process for prototypes and new products.},
	author = {Wagner, Nils and Tcherniak, Dmitri},
	month = nov,
	year = {2025},
	file = {Full Text PDF:source-pdfs/files/1863/Wagner and Tcherniak - 2025 - Data-Driven Updating of Digital Twins through Expe.pdf:application/pdf},
}

@book{carreira_foundations_2020,
	title = {Foundations of {Multi}-{Paradigm} {Modelling} for {Cyber}-{Physical} {Systems}},
	isbn = {978-1-155-11374-6},
	url = {https://library.oapen.org/handle/20.500.12657/37711},
	doi = {10.1007/978-3-030-43946-0},
	abstract = {This open access book coherently gathers well-founded information on the fundamentals of and formalisms for modelling cyber-physical systems (CPS). Highlighting the cross-disciplinary nature of CPS modelling, it also serves as a bridge for anyone entering CPS from related areas of computer science or engineering. Truly complex, engineered systems—known as cyber-physical systems—that integrate physical, software, and network aspects are now on the rise. However, there is no unifying theory nor systematic design methods, techniques or tools for these systems. Individual (mechanical, electrical, network or software) engineering disciplines only offer partial solutions. A technique known as Multi-Paradigm Modelling has recently emerged suggesting to model every part and aspect of a system explicitly, at the most appropriate level(s) of abstraction, using the most appropriate modelling formalism(s), and then weaving the results together to form a representation of the system. If properly applied, it enables, among other global aspects, performance analysis, exhaustive simulation, and verification. This book is the first systematic attempt to bring together these formalisms for anyone starting in the field of CPS who seeks solid modelling foundations and a comprehensive introduction to the distinct existing techniques that are multi-paradigmatic. Though chiefly intended for master and post-graduate level students in computer science and engineering, it can also be used as a reference text for practitioners.},
	language = {English},
	urldate = {2025-11-14},
	publisher = {Springer Nature},
	editor = {Carreira, Paulo and Amaral, Vasco and Vangheluwe, Hans},
	year = {2020},
	note = {Accepted: 2020-05-13T14:21:18Z},
	keywords = {IoT, Cyber-physical systems, Engineering, Special Purpose and Application-Based Systems, Software Engineering, AADL, Agriculture, CAE) and Design, Computer Applications, Computer-aided design (CAD), Computer-Aided Engineering (CAD, Concurrency Modeling, Cybernetics \& systems theory, Design Languages, DEVS, Electrical engineering, Embedded and cyber-physical systems, Expert systems / knowledge-based systems, Industrial processes::TH Energy technology and engineering::THR Electrical engineering, Information technology: general issues, Model-driven software engineering, Modelica, Multi-Paradigm Modeling, Open Access, Performance Analysis, Petri Nets, Software design engineering, Statecharts, System and Modeling, System Description Languages, thema EDItEUR::T Technology, thema EDItEUR::U Computing and Information Technology::UB Information technology: general topics, thema EDItEUR::U Computing and Information Technology::UG Graphical and digital media applications::UGC Computer-aided design (CAD), thema EDItEUR::U Computing and Information Technology::UM Computer programming / software engineering::UMZ Software Engineering, thema EDItEUR::U Computing and Information Technology::UY Computer science::UYQ Artificial intelligence::UYQE Expert systems / knowledge-based systems},
	file = {Carreira et al. - 2020 - Foundations of Multi-Paradigm Modelling for Cyber-.pdf:source-pdfs/files/1866/Carreira et al. - 2020 - Foundations of Multi-Paradigm Modelling for Cyber-.pdf:application/pdf},
}

@article{ferko_architecting_2022,
	title = {Architecting {Digital} {Twins}},
	volume = {10},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/abstract/document/9770073},
	doi = {10.1109/ACCESS.2022.3172964},
	abstract = {In 2002, Grieves defined the concept of the digital twin as a virtual instance of physical assets capable of continuously mirroring them. Ever since then, driven by remarkable industrial attention, digital twins flourished and ripened in several sectors. The notable industrial adoption has been sided by a growing interest from the software engineering community in general and the software architecture community in particular as demonstrated by the growing number of published peer-reviewed publications and proposed software architectural solutions for digital twins. In this paper, we report on the planning, execution, and results of a systematic mapping study on architecting digital twins. The study captures crucial aspects of software architectures for digital twins as types of architectural solutions, quality attributes, and architectural patterns. It supports practitioners in creating digital twins tailored to their specific needs and researchers in identifying trends and open challenges. Starting from an initial set of potentially relevant 1630 peer-reviewed publications, we selected 140 primary studies. We analysed the set of primary studies using thorough data extraction, analysis, and synthesis process. To compensate for single method limitations and reduce possible threats to conclusion validity, we discussed the results of our study with experts in the software architecture community. Based on our results, the field of software architecture for digital twins is lively and an increasing number of architectural solutions are being proposed. Although there is a lack of widely accepted reference architectural solutions for digital twins, most of them are built using a combination of the layered and service-oriented patterns and address maintainability, performance efficiency, and compatibility quality attributes.},
	urldate = {2025-11-14},
	journal = {IEEE Access},
	author = {Ferko, Enxhi and Bucaioni, Alessio and Behnam, Moris},
	year = {2022},
	keywords = {digital twin, Digital twin, Computer architecture, Software architecture, Market research, Standards, Systematics, Architectural patterns, Planning, quality attributes., software architectures},
	pages = {50335--50350},
	file = {Full Text PDF:source-pdfs/files/1868/Ferko et al. - 2022 - Architecting Digital Twins.pdf:application/pdf},
}

