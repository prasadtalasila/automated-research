@article{picone_wldt_2021,
	title = {{WLDT}: {A} general purpose library to build {IoT} digital twins},
	volume = {13},
	issn = {2352-7110},
	shorttitle = {{WLDT}},
	url = {https://www.sciencedirect.com/science/article/pii/S2352711021000066},
	doi = {10.1016/j.softx.2021.100661},
	abstract = {Digital twins are virtual software copies of physical objects and systems, and represent a strategic technology enabler to support Internet of Things devices and systems. Existing software frameworks for digital twins mainly operate in the cloud and are based on platform-specific solutions, harming interoperability and adaptability. However, it is getting recognized that Internet of Things and digital twins architectures can take advantage of microservices and platform-independent distributed architectures (also on the edge), promoting higher scalability, adaptability, and interoperability. In this context, we introduce WLDT (White Label Digital Twins), a general-purpose library that allows developers to create digital twins in terms of modular, adaptable, and inter-operable software agents. Among different features, WLDT library supports multiple standard protocols, caching, software processing pipeline and metrics monitoring.},
	urldate = {2024-04-21},
	journal = {SoftwareX},
	author = {Picone, Marco and Mamei, Marco and Zambonelli, Franco},
	month = jan,
	year = {2021},
	keywords = {Digital twin, Internet of Things, Library, Software agent},
	pages = {100661},
	annote = {Good software architecture. Might be an alternative to eKupier but the only disadvantage is the lack of traction among the community.
see the following links:
https://wldt.github.io/https://github.com/wldt
The software also has a good conceptual foundation for a DT and its lifecycle. The lifecycle is tied to the state of PT during its operation but not the PT lifecycle as understood by product lifecycle community.

},
	file = {Full Text:source-pdfs/files/187/Picone et al. - 2021 - WLDT A general purpose library to build IoT digit.pdf:application/pdf;ScienceDirect Snapshot:files/185/S2352711021000066.html:text/html},
