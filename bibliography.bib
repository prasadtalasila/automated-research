@article{liu_digital-twin-assisted_2022,
	title = {Digital-{Twin}-{Assisted} {Task} {Offloading} {Based} on {Edge} {Collaboration} in the {Digital} {Twin} {Edge} {Network}},
	volume = {9},
	issn = {2327-4662},
	url = {https://ieeexplore.ieee.org/abstract/document/9447819},
	doi = {10.1109/JIOT.2021.3086961},
	abstract = {Emerging digital twin (DT) and mobile-edge computing (MEC) are crucial for enabling the rapid development of 6G. However, the existing works ignore the edge collaboration, which can provide the system with additional performance gain. In this article, we study the problem of mobile users (MUs) intelligently offloading tasks to cooperative mobile-edge servers (MESs) with the assistance of DT. Specifically, a DT-assisted task offloading scheme (DTTOS) that consists of the selection of MESs and intelligent task offloading is proposed. Channel state information (CSI) and blockchain are employed to implement the selection of MESs. Then, we present a solution to enable MU’s task offloading that is modeled as a Markov decision process (MDP) in an intelligent way. After this, a mathematical optimization model aiming at decreasing power and time overhead is formulated. In view of the complexity, it is decomposed into two suboptimization models and solved by the decision tree algorithm (DTA) and double deep- Q -learning (DDQN), respectively. Simulations are conducted to prove the superiority of the proposed scheme in terms of data security assurance and network performance improvement.},
	number = {2},
	urldate = {2024-09-21},
	journal = {IEEE Internet of Things Journal},
	author = {Liu, Tong and Tang, Lun and Wang, Weili and Chen, Qianbin and Zeng, Xiaoping},
	month = jan,
	year = {2022},
	note = {Conference Name: IEEE Internet of Things Journal},
	keywords = {Servers, Task analysis, Data models, digital twin (DT), Delays, Artificial intelligence, Blockchain, Artificial intelligence (AI), blockchain, Collaboration, edge collaboration},
	pages = {1427--1444},
	annote = {Edge Networks, Task offloading
},
	file = {IEEE Xplore Abstract Record:source-pdfs/files/675/9447819.html:text/html;IEEE Xplore Full Text PDF:files/674/Liu et al. - 2022 - Digital-Twin-Assisted Task Offloading Based on Edg.pdf:application/pdf},
