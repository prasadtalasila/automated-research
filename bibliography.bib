@article{lienhardt_product_2024,
	title = {Product lines of dataflows},
	volume = {210},
	issn = {0164-1212},
	url = {https://www.sciencedirect.com/science/article/pii/S0164121223003230},
	doi = {10.1016/j.jss.2023.111928},
	abstract = {Data-centric parallel programming models such as dataflows are well established to implement complex concurrent software. However, in a context of a configurable software, the dataflow used in its computation might vary with respect to the selected options: this happens in particular in fields such as Computational Fluid Dynamics (CFD), where the shape of the domain in which the fluid flows and the equations used to simulate the flow are all options configuring the dataflow to execute. In this paper, we present an approach to implement product lines of dataflows, based on Delta-Oriented Programming (DOP) and term rewriting. This approach includes several analyses to check that all dataflows of a product line can be generated. Moreover, we discuss a prototype implementation of the approach and demonstrate its feasibility in practice.},
	urldate = {2024-10-30},
	journal = {Journal of Systems and Software},
	author = {Lienhardt, Michael and ter Beek, Maurice H. and Damiani, Ferruccio},
	month = apr,
	year = {2024},
	pages = {111928},
	file = {Lienhardt et al. - 2024 - Product lines of dataflows.pdf:source-pdfs/files/831/Lienhardt et al. - 2024 - Product lines of dataflows.pdf:application/pdf;ScienceDirect Snapshot:files/830/S0164121223003230.html:text/html},
}

@incollection{kamburjan_digital_2022,
	title = {Digital {Twin} {Reconfiguration} {Using} {Asset} {Models}},
	isbn = {978-3-031-19761-1},
	doi = {10.1007/978-3-031-19762-8_6},
	abstract = {Digital twins need to adapt to changes in the physical system they reflect. In this paper, we propose a solution to dynamically reconfigure simulators in a digital twin that exploits formalized asset models for this purpose. The proposed solution uses (1) semantic reflection in the programs orchestrating the simulators of the digital twin, and (2) semantic web technologies to formalize domain constraints and integrate asset models into the digital twin, as well as to validate semantically reflected digital twin configurations against these domain constraints on the fly. We provide an open-source proof-of-concept implementation of the proposed solution.},
	author = {Kamburjan, Eduard and Klungre, Vidar and Schlatte, Rudolf and Tapia Tarifa, Silvia Lizeth and Cameron, David and Johnsen, Einar Broch},
