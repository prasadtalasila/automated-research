	author = {Deng, Shuiguang and Zhao, Hailiang and Huang, Binbin and Zhang, Cheng and Chen, Feiyi and Deng, Yinuo and Yin, Jianwei and Dustdar, Schahram and Zomaya, Albert Y.},
