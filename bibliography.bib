	isbn = {978-0-12-817630-6},
	url = {https://www.sciencedirect.com/science/article/pii/B9780128176306000035},
	doi = {10.1016/B978-0-12-817630-6.00003-5},
	abstract = {Digital twin (DT) modeling is the basis for implementing DT in practice. As the concept of DT becomes better developed, many researchers and practitioners have been working on the construction of a DT. However, the initial three-dimension DT proposed by Grieves, including the physical entity, virtual entity, and connection, cannot accommodate the new requirements from applications, technology, modeling objects, etc. In this situation, an extended five-dimension DT, adding DT data and services, is proposed and explored in this chapter to meet the new demands. Based on this, the DT is further classified into three levels toward different applications: unit level, system level, and system of systems (SoS) level. Key technologies for the five-dimension DT are also discussed. Finally, eight rules for guiding future modeling works on the DT are proposed.},
	urldate = {2024-09-05},
