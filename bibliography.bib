	doi = {10.1007/978-3-031-66719-0_12},
	abstract = {We present four case studies of Digital Twins (DTs) through a DT description framework, covering 14 fundamental characteristics for each DT and its Physical Twin (PT). These characteristics uncover the diversity of the case studies, providing a deeper understanding of how these DTs interact with the real world, a sense of how they were built, and the challenges that were encountered. Following these examples, we advocate for the DT community to report on their own case studies using such a description framework. Having a common structure to experience reports, combined with explicit details for each characteristic, can both open further research avenues such as empirical studies on digital twins, and reveal best practices within the community.},
	language = {en},
