	pages = {63--81},
	file = {ScienceDirect Snapshot:source-pdfs/files/606/B9780128176306000035.html:text/html;Tao et al. - 2019 - Five-Dimension Digital Twin Modeling and Its Key T.pdf:files/607/Tao et al. - 2019 - Five-Dimension Digital Twin Modeling and Its Key T.pdf:application/pdf},
