	keywords = {structural health monitoring, digital twins, predictive maintenance, Computer vision, performance indicators, remote sensing, sensors},
	pages = {599--615},
	file = {Full Text PDF:source-pdfs/files/1778/Chacón et al. - 2025 - Requirements and challenges for infusion of SHM sy.pdf:application/pdf},
}

