	keywords = {Computer Science - Multiagent Systems},
	file = {Preprint PDF:source-pdfs/files/978/Dittler et al. - 2022 - An Agent-based Realisation for a continuous Model .pdf:application/pdf;Snapshot:files/979/2212.html:text/html},
}

