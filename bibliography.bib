}

@article{wooley_bridging_2025,
	series = {53rd {SME} {North} {American} {Manufacturing} {Research} {Conference} ({NAMRC} 53)},
	title = {Bridging the gap between discrete event simulation and digital twin: {A} manufacturing case study☆☆},
	volume = {44},
	issn = {2213-8463},
	shorttitle = {Bridging the gap between discrete event simulation and digital twin},
	url = {https://www.sciencedirect.com/science/article/pii/S2213846325001798},
	doi = {10.1016/j.mfglet.2025.06.147},
	abstract = {Computer simulation models are widely used to replicate and analyze stochastic systems, with Discrete Event Simulation (DES) being the most common technique to represent industrial settings. However, as the need to adapt to dynamic scenarios grows, Digital Twin (DT) technology has gained significant importance amid the Industry 4.0 landscape as an efficient alternative for designing and evaluating manufacturing systems. As DTs become a widespread technology, it raises the question of how to utilize and improve traditional DES models to incorporate DT capabilities and facilitate decision-making in a constantly evolving environment. This research presents a methodology to leverage a DES model to build a DT by enhancing its capabilities incrementally. The methodology provides a detailed guide for developers to create DTs that can overcome the limitations of traditional DES models, particularly in supporting dynamic, real-time scenarios. The main advantage of upgrading to DTs is their ability to operate and update in real-time (online) as opposed to the static (offline) nature of DES models, thus enhancing decision-making in constantly changing environments. Furthermore, the methodology is validated using a case study at an automotive engine manufacturing plant to transform a fully capable DES into a DT capable of replicating a pallet elevator.},
	urldate = {2025-10-10},
	journal = {Manufacturing Letters},
	author = {Wooley, Ana and Bitencourt, Julia and Silva, Daniel},
	month = aug,
	year = {2025},
	keywords = {Digital twin, Smart manufacturing, Simulation, Industry 4.0, Discrete event simulation},
	pages = {1274--1284},
	file = {ScienceDirect Snapshot:source-pdfs/files/1731/S2213846325001798.html:text/html;Wooley et al. - 2025 - Bridging the gap between discrete event simulation.pdf:files/1732/Wooley et al. - 2025 - Bridging the gap between discrete event simulation.pdf:application/pdf},
}

@article{emmert-streib_complexity_2024,
	title = {Complexity data science: {A} spin-off from digital twins},
	volume = {3},
	issn = {2752-6542},
	shorttitle = {Complexity data science},
	url = {https://doi.org/10.1093/pnasnexus/pgae456},
	doi = {10.1093/pnasnexus/pgae456},
	abstract = {Digital twins offer a new and exciting framework that has recently attracted significant interest in fields such as oncology, immunology, and cardiology. The basic idea of a digital twin is to combine simulation and learning to create a virtual model of a physical object. In this paper, we explore how the concept of digital twins can be generalized into a broader, overarching field. From a theoretical standpoint, this generalization is achieved by recognizing that the duality of a digital twin fundamentally connects complexity science with data science, leading to the emergence of complexity data science as a synthesis of the two. We examine the broader implications of this field, including its historical roots, challenges, and opportunities.},
	number = {11},
	urldate = {2025-10-15},
	journal = {PNAS Nexus},
	author = {Emmert-Streib, Frank and Cherifi, Hocine and Kaski, Kimmo and Kauffman, Stuart and Yli-Harja, Olli},
