	keywords = {digital twin, Computational modeling, Servers, Machine learning, Data models, Edge computing, federated learning, Data privacy, Optimization, Communication efficiency, energy cost, Industrial Internet of Things (IIOT)},
	pages = {5709--5718},
	file = {IEEE Xplore Abstract Record:source-pdfs/files/678/9145588.html:text/html;IEEE Xplore Full Text PDF:files/677/Lu et al. - 2021 - Communication-Efficient Federated Learning for Dig.pdf:application/pdf},
