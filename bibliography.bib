@misc{noauthor_cpced_nodate,
	title = {{CPCED}: a container escape detection system based on {CNI} plugin},
	annote = {Paper review

Merits of the paper are as follows.
1. Uses well-regarded CamFlow for setting up the experimental analysis2. Bases experimental work on CVE vulnerabilities.

What can be improved:
1. Literature review mentioning about existing reviews of security frameworks used in container and Kubernetes
2. There are also tools such as BPF and bcc which track the kernel activity at a more refined level. Perhaps it can provide a different vantage point to reach the same goals.
3. There are threat modeling frameworks from both research groups and commercial organizations (see https://doi.org/10.1016/j.cose.2023.103140). Can they help generalize the experimental work?
4. A more thorough algorithmic analysis and correctness may help appreciate the applicability of the proposed algorithm for large scale systems.
},
	file = {CPCED a container escape detection system based o.pdf:source-pdfs/files/770/CPCED a container escape detection system based o.pdf:application/pdf},
}

@misc{noauthor_logical_nodate,
	title = {Logical {Vulnerability} {Discovery} {Framework} for {Container} {Runtimes}},
	annote = {Paper Review:
Advantages of the paper:
1. Proposes a three stage framework (detection rules - detection-verification) so that the output of the discovery framework can be validated.
2. Considers concrete system calls to assess the potential vulnerabilities.
3. Uses call graph approach for detecting the vulnerabilities

Potential improvements:
1. There exist Linux kernel profiling tools which can detect the actual call graphs for a cgroups. Can they be used for selection of system calls instead of selecting the system calls apriori?
2. The call graph generation is some what simplistic. Can the frameworks like CamFlow improve the results?
3. Does the detection workflow scale for large number of selected system calls? It seems to scale linearly but there are bound to be cyclical calls in processes. Has this been considered?

},
	file = {Logical Vulnerability Discovery Framework for Cont.pdf:source-pdfs/files/772/Logical Vulnerability Discovery Framework for Cont.pdf:application/pdf},
}

@article{fizza_qoe_2021,
	title = {{QoE} in {IoT}: a vision, survey and future directions},
	volume = {1},
	issn = {2730-7239},
	shorttitle = {{QoE} in {IoT}},
	url = {http://link.springer.com/10.1007/s43926-021-00006-7},
	doi = {10.1007/s43926-021-00006-7},
	abstract = {Abstract
            The rapid evolution of the Internet of Things (IoT) is making way for the development of several IoT applications that require minimal or no human involvement in the data collection, transformation, knowledge extraction, and decision-making (actuation) process. To ensure that such IoT applications (we term them autonomic) function as expected, it is necessary to measure and evaluate their quality, which is challenging in the absence of any human involvement or feedback. Existing Quality of Experience (QoE) literature and most QoE definitions focuses on evaluating application quality from the lens of human receiving application services. However, in autonomic IoT applications, poor quality of decisions and resulting actions can degrade the application quality leading to economic and social losses. In this paper, we present a vision, survey and future directions for QoE research in IoT. We review existing QoE definitions followed by a survey of techniques and approaches in the literature used to evaluate QoE in IoT. We identify and review the role of data from the perspective of IoT architectures, which is a critical factor when evaluating the QoE of IoT applications. We conclude the paper by identifying and presenting our vision for future research in evaluating the QoE of autonomic IoT applications.},
	language = {en},
	number = {1},
	urldate = {2024-10-24},
	journal = {Discover Internet of Things},
	author = {Fizza, Kaneez and Banerjee, Abhik and Mitra, Karan and Jayaraman, Prem Prakash and Ranjan, Rajiv and Patel, Pankesh and Georgakopoulos, Dimitrios},
	month = dec,
	year = {2021},
	pages = {4},
	file = {Available Version (via Google Scholar):source-pdfs/files/774/Fizza et al. - 2021 - QoE in IoT a vision, survey and future directions.pdf:application/pdf},
}

