	file = {IEEE Xplore Abstract Record:source-pdfs/files/567/9613222.html:text/html;Lehner et al. - 2021 - Towards Flexible Evolution of Digital Twins with F.pdf:files/568/Lehner et al. - 2021 - Towards Flexible Evolution of Digital Twins with F.pdf:application/pdf},
