	month = aug,
	year = {2024},
	note = {\_eprint: https://doi.org/10.1080/15732479.2023.2264840},
	keywords = {digital twins, internet of things, Bridge load testing, building information modelling, cyber-physical bridge, railway bridges, standardization, unmanned aerial vehicles},
	pages = {1105--1119},
