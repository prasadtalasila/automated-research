@article{leng_digital_2021,
	title = {Digital twins-based smart manufacturing system design in {Industry} 4.0: {A} review},
	volume = {60},
	issn = {0278-6125},
	shorttitle = {Digital twins-based smart manufacturing system design in {Industry} 4.0},
	url = {https://www.sciencedirect.com/science/article/pii/S0278612521001151},
	doi = {10.1016/j.jmsy.2021.05.011},
	abstract = {A smart manufacturing system (SMS) is a multi-field physical system with complex couplings among various components. Usually, designers in various fields can only design subsystems of an SMS based on the limited cognition of dynamics. Conducting SMS designs concurrently and developing a unified model to effectively imitate every interaction and behavior of manufacturing processes are challenging. As an emerging technology, digital twins can achieve semi-physical simulations to reduce the vast time and cost of physical commissioning/reconfiguration by the early detection of design errors/flaws of the SMS. However, the development of the digital twins concept in the SMS design remains vague. An innovative Function-Structure-Behavior-Control-Intelligence-Performance (FSBCIP) framework is proposed to review how digital twins technologies are integrated into and promote the SMS design based on a literature search in the Web of Science database. The definitions, frameworks, major design steps, new blueprint models, key enabling technologies, design cases, and research directions of digital twins-based SMS design are presented in this survey. It is expected that this survey will shed new light on urgent industrial concerns in developing new SMSs in the Industry 4.0 era.},
	urldate = {2025-03-04},
	journal = {Journal of Manufacturing Systems},
	author = {Leng, Jiewu and Wang, Dewen and Shen, Weiming and Li, Xinyu and Liu, Qiang and Chen, Xin},
	month = jul,
	year = {2021},
	keywords = {Smart manufacturing, Digital twins, Cyber-physical systems, Function-structure-behavior-control-intelligence-performance, Manufacturing system design},
	pages = {119--137},
	file = {Leng et al. - 2021 - Digital twins-based smart manufacturing system des.pdf:source-pdfs/files/1347/Leng et al. - 2021 - Digital twins-based smart manufacturing system des.pdf:application/pdf},
}

@article{zhang_digital_2021,
	title = {Digital twin-enabled reconfigurable modeling for smart manufacturing systems},
	volume = {34},
	issn = {0951-192X},
	url = {https://doi.org/10.1080/0951192X.2019.1699256},
	doi = {10.1080/0951192X.2019.1699256},
	abstract = {The digital twin-based manufacturing system is a typical representative of smart manufacturing and has a number of advantages beyond the state of the art. However, when a manufacturing system needs to be reconfigured to meet new requirements of production, manual reconfiguration is time-consuming and high labor cost because of the complexity of the digital twin-based manufacturing system and the imperfection of related models. This problem will be even worse if there are industrial robots with characteristics of complex functions and inflexible programming in the manufacturing system. This paper presents a five-dimensional fusion model of a digital twin virtual entity for robotics-based smart manufacturing systems to support automatic reconfiguration, which can not only realistically describes physical manufacturing resources, but also represents the capabilities and dependencies of the digital twins. Reconfigurable strategies based on service function blocks, which can improve the reusability of functions and algorithms, are proposed to make the robotics-based manufacturing system satisfy the various reconfigurable requirements of different granularities and goals. Finally, a prototype system is developed to demonstrate the performance of the reconfigurable digital twin-based manufacturing system, which can improve the operation efficiency of such systems for carrying out the reconfiguring production tasks in a flexible way.},
	number = {7-8},
	urldate = {2025-03-04},
	journal = {International Journal of Computer Integrated Manufacturing},
	publisher = {Taylor \& Francis},
	author = {Zhang, Chenyuan and Xu, Wenjun and Liu, Jiayi and Liu, Zhihao and Zhou, Zude and Pham, Duc Truong},
	month = aug,
	year = {2021},
	note = {\_eprint: https://doi.org/10.1080/0951192X.2019.1699256},
	keywords = {Digital twin, industrial robots, reconfigurable strategy, service function block, smart manufacturing system},
	pages = {709--733},
	file = {Full Text PDF:source-pdfs/files/1349/Zhang et al. - 2021 - Digital twin-enabled reconfigurable modeling for s.pdf:application/pdf},
}

@article{liu_digital_2023,
	title = {Digital {Twin}-based manufacturing system: a survey based on a novel reference model},
	volume = {35},
	shorttitle = {Digital {Twin}-based manufacturing system},
	doi = {10.1007/s10845-023-02172-7},
	abstract = {The development of advanced information technologies are paving the digital transformation of manufacturing systems, of which Digital Twin-based manufacturing system (DTMS) has become a prevailing topic attracted ever-increasing concerns from both industry and academia. As a cutting-edge smart manufacturing system, DTMS can improve manufacturing accuracy and efficiency based on high fidelity simulation, near real-time monitoring and control in a cyber-physical integrated manner. However, the connotation and boundary of DTMS lack a clear definition and systematic analysis. Therefore, this paper reviews the existing Digital Twin reference models and implementation architectures on manufacturing system, and further proposes a reference model of DTMS. Based on it, the characteristics and operational mechanism of DTMS are analyzed from three perspectives: hierarchy, dimension, and scale. Specifically, the composition of DTMS is described from a multi-level perspective, the specific characteristics of the DTMS are analyzed from a multi-dimensional perspective, and the temporal and spatial characteristics of the DTMS under different application scenarios are depicted from a multi-scale perspective, respectively. At last, the potential research directions of DTMS are highlighted in terms of reusability, interpretability and adaptability. It is envisioned that this work can provide a clear understanding with insightful knowledge to attract more in-depth research of DTMS.},
	journal = {Journal of Intelligent Manufacturing},
	author = {Liu, Shimin and Zheng, Pai and Jinsong, Bao},
	month = jul,
	year = {2023},
	pages = {1--30},
	file = {Full Text PDF:source-pdfs/files/1351/Liu et al. - 2023 - Digital Twin-based manufacturing system a survey .pdf:application/pdf},
}

@misc{noauthor_formal_nodate,
	title = {Formal {Specification} and {Executable} {Analysis} of {Digital} {Twin} {Systems} {Using} {Maude} {Rewriting} {Logic}},
	annote = {Consolidated Reviewer Comments for original submission:
Reviewer \#1: The manuscript presents a framework for digital twins (DTs) aimed at facilitating system specification and analysis. This framework is formalized in Maude—a reflective system that supports specification and programming through rewriting logic—and offers both formal specification and executability. The topic is timely and of significant interest. However, I have several concerns regarding the manuscript, ranging from the quality of the presentation to the soundness of the results.My major concerns are the following:1. §4.3: The manuscript currently constrains \$D\_S\$ to exhibit only the equivalent characteristics and behavior of \$P\_S\$. I believe the authors should expand the scope of \$D\_S\$, particularly by addressing two key aspects: contextualization and augmentation. In many practical applications, only a subset of the characteristics of the physical twin (PT) are of interest, depending on the specific context and purpose of the DT. Moreover, a DT often serves not only to replicate but also to enhance the PT, enriching its state with inferred or computed properties that are not directly observable. These properties, and several others, are discussed at length in "Digital Twin in the IoT Context: A Survey on Technical Features, Scenarios, and Architectural Models."2. §5: While the explanation of rewriting logic and Maude is generally clear, it does not provide a sufficient foundation for fully understanding the remainder of the section. Moreover, the presentation is highly fragmented, with textual descriptions and code snippets interleaved in a way that disrupts the narrative flow. This structure makes it difficult to grasp the underlying ideas cohesively. Similar issues are present in §§6 and 7.3. §6.4: The authors should provide a clearer explanation of the conclusion they draw regarding state synchronization. Specifically, they claim that if the initial states of the physical and digital counterparts are not synchronized, the systems will never converge. This assertion requires further elaboration. Why does the lack of initial synchronization lead to perpetual divergence? Moreover, the practical implications of this result should be critically examined. In real-world DT implementations, initial states are rarely synchronized by default. Typically, the DT starts independently, binds to the PT at runtime, and only then begins the process of synchronization. Furthermore, even after synchronization is achieved, a range of issues—such as network latency, packet loss, or hardware faults—can cause the counterparts to become unsynchronized.4. §7.4: The authors draw the same conclusion as in §6.4. What is the added value of this result?5. §8: Why do the more complex system exhibited transient partial synchronization while the less complex one consistently failed to synchronize? This insight is also only briefly mentioned in the conclusion and is not addressed earlier in the manuscript. A discussion of this phenomenon should be introduced and elaborated upon in §7.4.My minor concerns are the following:1. §2.1: The discussion on the definitions of DT provided in the literature is rather limited. In my opinion, the authors should give a better overview of this topic and explicitly point out which definition of DT they adopt.2. Figure 1: The term "digital thread" is not explained in the text. It is also not clear to me why "interpretation" is outside both the DT block and the PT block.3. §3.1.1: I believe a piece of copy-and-paste text remained in the manuscript, starting from "we applied..." where the authors refer to someone else's work.Reviewer \#2: Thank you submitting the paper. It is timely and the approach taken is worthy of dissemination. I have the following comments on the manuscript.1) Can this technique be reused for existing digital twins (DTs) which need to be represented using the techniques illustrated in this paper?2) The event-driven approach has been taken to architect the system. I personally prefer the state-machine approach taken in this paper. It has rich history and sound conceptual underpinnings. But, how does the Maude rewriting logic apply to functional and / or reactive programming approaches. Are there any inherent advantages to taking this event-driven, state machine approach.3) The Fig. 1 shows storage on top of DT. But how does DT use historic data if the data storage is reliant on DT as there is no way to go from DT to storage? If there is, this layered architecture needs to be explained better. Another question is on the analytics. Why can't it be clubbed with the applications layer?4) The run-time monitoring and formal verification is being called Digital Model in section 3.2. Is this consistent with the definitions introduced in section 2.3?5) A citation on the survey of the following would be appropriate in the related work.a) surveys on run-time verification and formal modeling surveysb) a paper on the run-time verification and formal analysis of incubator presented in"Kristensen, Morten Haahr, et al. "Runtime Verification of Autonomous Systems Utilizing Digital Twins as a Service." 2024 IEEE International Conference on Autonomic Computing and Self-Organizing Systems Companion (ACSOS-C). IEEE, 2024."6) What do users and other systems consume and generate in fig. 4?7) In the queues of Digital Thread (DT) there seems to be two queues which do not perform much. If there are any event transformation required, the incoming/outgoing processors of physical world can perform the same task. Is there a value addition to DT? In addition, the use of DT is inconsistent with the prevalent definition of DT in the context of product life-cycle management. Please clarify regarding the same in the manuscript.8) The events presented in Table 2 are not sufficiently representative of the events for which the Formal Methods of this study is motivated to be used. Is there a need to enhance the kind of events included? If so, why and what kind of events?9) The thermostat example is not sufficiently illustrate. Perhaps adding more events like "break down" might help illustrate the example better.10) An experimental evaluation would be a nice addition to improve the quality of the paper.Corrections:---1) The end of first paragraph in subsection 3.1.1 mentions vehicle-based case study which is not used in this paper. Please rephrase the sentence.2) The fig. 3 is highly ambiguous about the message flows. It is better to identify the end-to-end message flows which fig. 4 conveys better. Is there a way to improve fig. 3?More information and support FAQ: How do I revise my submission in Editorial Manager?https://service.elsevier.com/app/answers/detail/a\_id/28463/supporthub/publishing/FAQ: How can I reset a forgotten password?https://service.elsevier.com/app/answers/detail/a\_id/28452/supporthub/publishing/kw/editorial+manager/For further assistance, please visit our customer service site: https://service.elsevier.com/app/home/supporthub/publishing/. Here you can search for solutions on a range of topics, find answers to frequently asked questions, and learn more about Editorial Manager via interactive tutorials. You can also talk 24/7 to our customer support team by phone and 24/7 by live chat and email.At Elsevier, we want to help all our authors to stay safe when publishing. Please be aware of fraudulent messages requesting money in return for the publication of your paper. If you are publishing open access with Elsevier, bear in mind that we will never request payment before the paper has been accepted. We have prepared some guidelines (https://www.elsevier.com/connect/authors-update/seven-top-tips-on-stopping-apc-scams ) that you may find helpful, including a short video on Identifying fake acceptance letters (https://www.youtube.com/watch?v=o5l8thD9XtE ). Please remember that you can contact Elsevier s Researcher Support team (https://service.elsevier.com/app/home/supporthub/publishing/) at any time if you have questions about your manuscript, and you can log into Editorial Manager to check the status of your manuscript (https://service.elsevier.com/app/answers/detail/a\_id/29155/c/10530/supporthub/publishing/kw/status/).\#AU\_FGCS\#To ensure this email reaches the intended recipient, please do not delete the above code
},
	file = {original-submission.pdf:source-pdfs/files/1354/original-submission.pdf:application/pdf;Revision-1.pdf:files/1466/Revision-1.pdf:application/pdf},
}

@incollection{grieves_digital_2017,
	address = {Cham},
	title = {Digital {Twin}: {Mitigating} {Unpredictable}, {Undesirable} {Emergent} {Behavior} in {Complex} {Systems}},
	isbn = {978-3-319-38756-7},
	shorttitle = {Digital {Twin}},
	url = {https://doi.org/10.1007/978-3-319-38756-7_4},
	doi = {10.1007/978-3-319-38756-7_4},
	abstract = {Systems do not simply pop into existence. They progress through lifecycle phases of creation, production, operations, and disposal. The issues leading to undesirable and unpredicted emergent behavior are set in place during the phases of creation and production and realized during the operational phase, with many of those problematic issues due to human interaction. We propose that the idea of the Digital Twin, which links the physical system with its virtual equivalent can mitigate these problematic issues. We describe the Digital Twin concept and its development, show how it applies across the product lifecycle in defining and understanding system behavior, and define tests to evaluate how we are progressing. We discuss how the Digital Twin relates to Systems Engineering and how it can address the human interactions that lead to “normal accidents.” We address both Digital Twin obstacles and opportunities, such as system replication and front running. We finish with NASA’s current work with the Digital Twin.},
	language = {en},
	urldate = {2025-03-28},
	booktitle = {Transdisciplinary {Perspectives} on {Complex} {Systems}: {New} {Findings} and {Approaches}},
	publisher = {Springer International Publishing},
	author = {Grieves, Michael and Vickers, John},
	editor = {Kahlen, Franz-Josef and Flumerfelt, Shannon and Alves, Anabela},
	year = {2017},
	keywords = {Additive Manufacturing, Physical System, Sensory Visual, Undesirable Behavior, Virtual Space},
	pages = {85--113},
	file = {Full Text PDF:source-pdfs/files/1356/Grieves and Vickers - 2017 - Digital Twin Mitigating Unpredictable, Undesirabl.pdf:application/pdf},
}

@incollection{abbiati_modelling_2024-2,
	address = {Cham},
	title = {Modelling for {Digital} {Twins}},
	isbn = {978-3-031-66719-0},
	url = {https://doi.org/10.1007/978-3-031-66719-0_5},
	doi = {10.1007/978-3-031-66719-0_5},
	abstract = {At the heart of a digital twin is one or more models of the real-world system that it aims to describe. There are many facets to real-world systems, and many types of model available to describe them, each with different strengths. We provide an introduction to a range of model types. These include physics-based models founded on first principles laws, data-driven models derived by machine learning from experimental data, and formalisms rooted in discrete mathematics and logic to describe computational processes. We describe approaches to harnessing these diverse types of model together, in particular co-simulation in which models are integrated in a principled and coordinated execution, and the formal integration of discrete and continuous behaviours in hybrid automata. The practical use of some of the most common formalisms has been showcased using an incubator example.},
	language = {en},
	urldate = {2025-03-28},
	booktitle = {The {Engineering} of {Digital} {Twins}},
	publisher = {Springer International Publishing},
	author = {Abbiati, Giuseppe and Gomes, Cláudio and Sandberg, Michael and Kazemi, Zahra and Hansen, Simon Thrane and Larsen, Peter Gorm},
	editor = {Fitzgerald, John and Gomes, Cláudio and Larsen, Peter Gorm},
	year = {2024},
	pages = {89--127},
	file = {Full Text PDF:source-pdfs/files/1363/Abbiati et al. - 2024 - Modelling for Digital Twins.pdf:application/pdf},
}

@inproceedings{ferko_standardisation_2023,
	title = {Standardisation in {Digital} {Twin} {Architectures} in {Manufacturing}},
	url = {https://ieeexplore.ieee.org/abstract/document/10092613},
	doi = {10.1109/ICSA56044.2023.00015},
	abstract = {Engineering digital twins following standardised reference architectures is an upcoming requirement for ensuring their adoption and facilitating their creation, processing, and integration. The ISO 23247 standard proposes a reference architecture for digital twins in manufacturing, including an entity-based reference model and a functional view specified in terms of functional entities. During our experience with projects in the field, we noticed that standards, and in particular the ISO 23247 standard, are not completely followed. In this paper, we analyse to what extent digital twin architectures documented in the literature are aligned with the reference architecture presented in the ISO 23247 standard. We achieved this through a mixed-methods research methodology that includes the analysis of 29 digital twin architectures in the manufacturing domain resulting from a systematic literature review of 140 peer-reviewed studies, a survey with 33 respondents, and four semi-structured, in-depth expert interviews. On the basis of our findings, practitioners and researchers can reflect, discuss, and plan actions for future research and development activities.},
	urldate = {2025-03-28},
	booktitle = {2023 {IEEE} 20th {International} {Conference} on {Software} {Architecture} ({ICSA})},
	author = {Ferko, Enxhi and Bucaioni, Alessio and Pelliccione, Patrizio and Behnam, Moris},
	month = mar,
	year = {2023},
	keywords = {Digital Twin, Computer architecture, Digital twins, Software architecture, Software, Systematics, Manufacturing, ISO 23247, ISO Standards, Reference Architecture, Software Architecture},
	pages = {70--81},
	file = {Full Text PDF:source-pdfs/files/1366/Ferko et al. - 2023 - Standardisation in Digital Twin Architectures in M.pdf:application/pdf;IEEE Xplore Abstract Record:files/1367/10092613.html:text/html},
}

