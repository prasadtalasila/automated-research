	keywords = {smart manufacturing, connections, cyber-physical system (CPS), Digital twin (DT), Internet of Things (IoT)},
	pages = {243--256},
	file = {ScienceDirect Snapshot:source-pdfs/files/603/B9780128176306000126.html:text/html;Tao et al. - 2019 - Chapter 12 - Digital Twin, Cyber–Physical System, .pdf:files/604/Tao et al. - 2019 - Chapter 12 - Digital Twin, Cyber–Physical System, .pdf:application/pdf},
}

@incollection{tao_five-dimension_2019-1,
