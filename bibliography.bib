@inproceedings{laukkarinen_devops_2017,
	address = {Buenos Aires, Argentina},
	series = {{ICSE}-{NIER} '17},
	title = {{DevOps} in regulated software development: case medical devices},
	isbn = {978-1-5386-2675-7},
