	keywords = {behavior modeling, Digital Twins, language engineering, model-driven engineering, modeling patterns, patterns},
	pages = {423--443},
	file = {Full Text PDF:source-pdfs/files/572/Lehner et al. - 2023 - A pattern catalog for augmenting Digital Twin mode.pdf:application/pdf},
