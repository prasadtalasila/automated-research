@inproceedings{kamburjan_greenhousedt_2024,
	address = {New York, NY, USA},
	series = {{SEAMS} '24},
	title = {{GreenhouseDT}: {An} {Exemplar} for {Digital} {Twins}},
	isbn = {979-8-4007-0585-4},
	shorttitle = {{GreenhouseDT}},
	url = {https://dl.acm.org/doi/10.1145/3643915.3644108},
	doi = {10.1145/3643915.3644108},
	abstract = {Digital twins, which are increasingly adopted in industry, are model-centric systems used to improve the behavior of a twinned physical system. Seen as a whole, this system has several layers of self-adaptation: first, the digital twin manages its physical counterpart and maintains its models through a feedback loop to, e.g., fine-tune model parameters. Second, the digital twin needs to deal with unforeseen changes in the composition of the physical system, which require models to be partly replaced or recomposed. To facilitate research on self-adaptive digital twins, without requiring access to industrial production systems, this paper presents GreenhouseDT, an exemplar that explicitly separates these layers of self-adaptation. GreenhouseDT provides an extensible software architecture for a digital twin of a simple, low-cost greenhouse, in which plants, sensors and water pumps constitute the physical system. GreenhouseDT includes an asset model in the digital twin's knowledge base and uses reflection to lift twinned configurations into the knowledge base. We discuss how GreenhouseDT can be extended with different digital twin capabilities, demonstrated by the addition of plant health monitoring and model-based control.},
	urldate = {2024-12-13},
	booktitle = {Proceedings of the 19th {International} {Symposium} on {Software} {Engineering} for {Adaptive} and {Self}-{Managing} {Systems}},
	publisher = {Association for Computing Machinery},
	author = {Kamburjan, Eduard and Sieve, Riccardo and Prabhu Baramashetru, Chinmayi and Amato, Marco and Barmina, Gianluca and Occhipinti, Eduard and Broch Johnsen, Einar},
	month = jun,
	year = {2024},
	pages = {175--181},
	annote = {codebase: recreate PT and DT code
Riccardo Sieve is currently the lead developer
},
	file = {Full Text PDF:source-pdfs/files/1030/Kamburjan et al. - 2024 - GreenhouseDT An Exemplar for Digital Twins.pdf:application/pdf},
}

@misc{noauthor_cbnrm_nodate,
	title = {{CbNRM}: {Reliability} model for industrial network considering dynamic fault causal and multi-applications},
	annote = {The problem deals with the impact of the physical network performance the application reliability. The novel ideas of the paper are:
1) Authors select standard models for both the network and applications.
2) The repeated sampling of application and network states reduce the algorithmic complexity of the problem. But it also converts deterministic problem to probabilistic ones. However, the algorithms proposed seem appropriate for the models selected.
3) The motivation and the impact of the results on the problem at hand requires further clarification but it can be revised further.
4) Use of multi-layer networks for simulation of industrial networks is appropriate. The software defined networks (SDN) have become a growing piece of network infrastructure. The simulation approach naturally moves the application performance towards including SDN in industrial networks.
---------
I have the following questions on the paper.
page-4, first column:
There is a selected network topology for the selected use case. Why does network need to be reconstructed? Are the following assumptions valid?
Dynamics of network topology are more frequent and severe than those of application topology. (mostly not true unless it is a wireless network. The evaluation setup has wireless network only on the edge.)
page-6
Can application configs like infrastructure as code (IaC) help reinforce the insights provided by CbNRM framework?
page-6, line-53, first column:
What is the justification for M {\textless} N?
Algorithm 1: This algorithm can be simplified by by making calls to PC and RF algorithms.
page-7, line 52, first column:
At present the heuristics (like 100 dimensions) are spread all over the text.
It would be nice to have a paragraph explaining the heuristics used and provide a justification for the same.The paragraph could also go into Appendix (if permitted by the journal).
page-9, line-30, first column:
Why simulate? The application logs / performance indicators should give this information?
Equation 2: Is there a comma between i and k on left side?
page-9, line-43, second column:
Please clarify the basis for choosing this system and not any other system. If a simulation of dependencies between application performance indicators is to be done, can it be selected from existing literature (if any)?
page-12, line-54, second column: The industrial network does get affected by the application loads. Is this captured in the statistical model of the network?
page 13, line 40, second column: The industrial networks having multiple routers (L3 networks) is not so prevalent. Or at least please provide a pointers to background work justifying the need for using such a scenario.
If industrial networks are L2 networks, then the algorithms used for route resolutions are different.
Equation 11: Should there be a tuple notation on the right side?
page 15, line-38, first column: How does the backup become active?
Figure 13(b): Is there a thinning of network connections due to L2 and L3 protocols used? Is there a thinning of connections due to the application of double-layer topology?
page 17, line 22, second column: At these reliability values, the faults in the complete system is mostly ({\textgreater}95\%) affected by the faults in the applications themselves. Am I misunderstanding the implications of these numbers?
--------
The written english is good but there are glaring issues at some places. The page numbers mentioned here are from the document given to the reviewers. The ones I found are:
page 2, line-34, second column: environments such (no space between the words)
page 2, line-35, second column: parameters modeling (no space between the words)
Figure 1: structural --{\textgreater} structure
page 5, line 59, second column: chapter --{\textgreater} paper
Table 1: wrong caption
page 9, line 47, second column: date --{\textgreater} data
page-12, line 12, first column: The notation G is used with out explaining before
page-14, line 49, first column: time. For (space at the beginning of sentence)
Other problems I found are:
page 4, line-39, second column: TSN-related (TSN undefined)
page 18: copywright statement, copyright and rules of use sections need to be either removed or rewritten

},
	file = {CbNRM Reliability model for industrial network co.pdf:source-pdfs/files/1033/CbNRM Reliability model for industrial network co.pdf:application/pdf},
}

