@article{anwer_developing_2025,
	title = {Developing and leveraging digital twins in engineering design},
	volume = {2025},
	doi = {10.1016/j.cirp.2025.05.002},
	abstract = {Digital twins are digital representations of real-world entities constantly fed by dynamic, bidirectional communication and updates throughout the lifecycle of these sophisticated paired systems. Developing digital twins in production engineering creates new avenues for engineering design in the context of digital transformation in manufacturing and sociotechnical systems. This paper reviews the foundational concepts, meth-odologies, and applications of digital twins in engineering design, covering both their architecture and development (engineering of digital twins), and their utilisation to enhance design activities (engineering with digital twins). An overview of the current state-of-the-art is presented, challenges are highlighted, and future research directions are addressed.},
	journal = {CIRP Annals},
	author = {Anwer, N and Stark, Rainer and Tao, F and Erkoyuncu, J},
	month = jun,
	year = {2025},
	file = {Full Text PDF:source-pdfs/files/1500/Anwer et al. - 2025 - Developing and leveraging digital twins in enginee.pdf:application/pdf},
}

@inproceedings{franke_fiware_2025,
	title = {{FIWARE} as a {Scalable} {Digital} {Twin} {Interface} for {DT} {Ecosystems}: {Benchmark} and {Limitations}},
	issn = {2766-8576},
	shorttitle = {{FIWARE} as a {Scalable} {Digital} {Twin} {Interface} for {DT} {Ecosystems}},
	url = {https://ieeexplore.ieee.org/document/11038742},
	doi = {10.1109/PerComWorkshops65533.2025.00054},
	abstract = {While there are many efforts to create interactive Digital Twins that use simulations and a centralized data model, the management of communication in a decentralized Digital Twin ecosystem is less researched. Such an ecosystem is essential, whenever complex systems need to be mapped to their virtual counterpart and there is a high functional dependency between parts of the system. This paper presents an entity-based approach to build up such an ecosystem of Digital Twins using decentralized data models. The communication of differently scaled systems are benchmarked to demonstrate the functionality of our approach. We show that the the implemented Digital Twin Ecosystem is capable of establishing interconnected subsystems by synchronizing entities at their domain borders using the FIWARE Orion Context Broker. We achieve low latency values for a moderate amount of boundary entities and subsystems. However, more work needs to be done to decrease the latency when using more than 20 systems with more than 100 boundary entities per system. The presented solution can be extended by providing more simulations, systems or entities within.},
	urldate = {2025-06-23},
	booktitle = {2025 {IEEE} {International} {Conference} on {Pervasive} {Computing} and {Communications} {Workshops} and other {Affiliated} {Events} ({PerCom} {Workshops})},
	author = {Franke, Kai and Koch, Tobias},
	month = mar,
	year = {2025},
	keywords = {Digital Twin, Computational modeling, Digital twins, Conferences, Data models, Ecosystems, Benchmark testing, communication, Complex systems, decentralization, Low latency communication, Pervasive computing},
	pages = {134--139},
	file = {Full Text PDF:source-pdfs/files/1503/Franke and Koch - 2025 - FIWARE as a Scalable Digital Twin Interface for DT.pdf:application/pdf},
}

