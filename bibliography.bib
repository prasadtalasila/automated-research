	pages = {12--46},
	file = {IEEE Xplore Abstract Record:source-pdfs/files/1174/10433234.html:text/html;Submitted Version:files/1175/Deng et al. - 2024 - Cloud-Native Computing A Survey From the Perspect.pdf:application/pdf},
